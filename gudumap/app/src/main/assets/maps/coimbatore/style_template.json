{
  "version": 8,
  "name": "Naviator Dark Navy (Coimbatore offline)",
  "sources": {
    "coimbatore": {
      "type": "vector",
      "url": "{{MBTILES_URL}}"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#0A0E27"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "coimbatore",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#1A2142",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "landuse-park",
      "type": "fill",
      "source": "coimbatore",
      "source-layer": "park",
      "paint": {
        "fill-color": "#34D399",
        "fill-opacity": 0.1
      }
    },
    {
      "id": "landuse-general",
      "type": "fill",
      "source": "coimbatore",
      "source-layer": "landuse",
      "filter": [
        "!=",
        [
          "get",
          "class"
        ],
        "park"
      ],
      "paint": {
        "fill-color": "#161B38",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "coimbatore",
      "source-layer": "water",
      "paint": {
        "fill-color": "#12172E"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "coimbatore",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#12172E",
        "line-width": 1.5
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "coimbatore",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-color": "#161B38",
        "fill-outline-color": "#5B6699",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "coimbatore",
      "source-layer": "boundary",
      "paint": {
        "line-color": "#5B6699",
        "line-width": 1,
        "line-dasharray": [
          3,
          2
        ],
        "line-opacity": 0.6
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "coimbatore",
      "source-layer": "transportation",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "minor",
            "service",
            "track"
          ]
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#9CA3C9",
        "line-width": 1,
        "line-opacity": 0.7
      }
    },
    {
      "id": "road-path",
      "type": "line",
      "source": "coimbatore",
      "source-layer": "transportation",
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "path"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#5B6699",
        "line-width": 0.75,
        "line-dasharray": [
          1,
          1.5
        ]
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "coimbatore",
      "source-layer": "transportation",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "secondary",
            "tertiary"
          ]
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#A78BFA",
        "line-width": 1.8
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "coimbatore",
      "source-layer": "transportation",
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "primary"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#A78BFA",
        "line-width": 2.6
      }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "coimbatore",
      "source-layer": "transportation",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "motorway",
            "trunk"
          ]
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#22D3EE",
        "line-width": 3.2
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "coimbatore",
      "source-layer": "transportation",
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "rail"
      ],
      "paint": {
        "line-color": "#5B6699",
        "line-width": 1,
        "line-dasharray": [
          2,
          2
        ]
      }
    },
    {
      "id": "poi-point",
      "type": "circle",
      "source": "coimbatore",
      "source-layer": "poi",
      "minzoom": 15,
      "paint": {
        "circle-radius": 3,
        "circle-color": "#A78BFA",
        "circle-stroke-width": 1,
        "circle-stroke-color": "#0A0E27"
      }
    },
    {
      "id": "place-point",
      "type": "circle",
      "source": "coimbatore",
      "source-layer": "place",
      "maxzoom": 12,
      "paint": {
        "circle-radius": 2.5,
        "circle-color": "#E8EAF6",
        "circle-opacity": 0.8
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "coimbatore",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "filter": [
        "all",
        [
          "!=",
          [
            "get",
            "class"
          ],
          "path"
        ],
        [
          "!=",
          [
            "get",
            "class"
          ],
          "rail"
        ]
      ],
      "layout": {
        "symbol-placement": "line-center",
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ],
          [
            "get",
            "ref"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          10,
          16,
          13
        ],
        "text-letter-spacing": 0.02,
        "symbol-spacing": 300
      },
      "paint": {
        "text-color": "#CBD5E1",
        "text-halo-color": "#0A0E27",
        "text-halo-width": 1.2,
        "text-halo-blur": 0.3
      }
    },
    {
      "id": "water-label",
      "type": "symbol",
      "source": "coimbatore",
      "source-layer": "water_name",
      "minzoom": 12,
      "layout": {
        "symbol-placement": "point",
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11
      },
      "paint": {
        "text-color": "#5B7A9C",
        "text-halo-color": "#0A0E27",
        "text-halo-width": 1
      }
    },
    {
      "id": "poi-label",
      "type": "symbol",
      "source": "coimbatore",
      "source-layer": "poi",
      "minzoom": 16,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 10,
        "text-anchor": "top",
        "text-offset": [
          0,
          0.6
        ],
        "text-optional": true
      },
      "paint": {
        "text-color": "#C4B5FD",
        "text-halo-color": "#0A0E27",
        "text-halo-width": 1
      }
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "coimbatore",
      "source-layer": "place",
      "maxzoom": 14,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "city",
              "town"
            ],
            12,
            9
          ],
          12,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "city",
              "town"
            ],
            16,
            11
          ],
          14,
          [
            "match",
            [
              "get",
              "class"
            ],
            [
              "city",
              "town"
            ],
            18,
            13
          ]
        ],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.05,
        "text-anchor": "top",
        "text-offset": [
          0,
          0.5
        ]
      },
      "paint": {
        "text-color": "#E8EAF6",
        "text-halo-color": "#0A0E27",
        "text-halo-width": 1.2
      }
    }
  ],
  "glyphs": "{{GLYPHS_URL}}"
}
