<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background layer: a subtle vertical gradient between the two real navy
     tones from Phase 1's Color.kt (NavyBase #0A0E27 to NavySurface #12172E), not an invented
     color. Flat/near-flat by design; the pin foreground layer carries all the visual
     interest, this is just the app's own background tone showing through. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108">
                <item android:color="#FF0A0E27" android:offset="0.0" />
                <item android:color="#FF12172E" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
